# ==============================================================================
# ServiceFlow Environment Configuration (Development Template)
# Copy to .env for local Docker Compose execution.
# ==============================================================================

# Application
APP_NAME=ServiceFlow
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Exposed Ports
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Security Secrets (Generate cryptographically secure 32+ character keys in production)
APP_SECRET_KEY=dev-insecure-app-secret-key-change-in-production-32chars
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false

# PostgreSQL Database Configuration
POSTGRES_DB=serviceflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/serviceflow

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6379/1

# Worker Concurrency & Workflows
CELERY_WORKER_CONCURRENCY=4
PROCESSING_STEP_DELAY_SECONDS=2.0

# Frontend Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
